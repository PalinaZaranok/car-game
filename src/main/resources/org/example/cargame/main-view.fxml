<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.cargame.CarGameController"
            prefWidth="830" prefHeight="610"
            style="-fx-background-color: #f4f4f4;" focusTraversable="true">

  <top>
    <VBox spacing="8">
      <padding>
        <Insets top="12" right="12" bottom="8" left="12"/>
      </padding>

      <HBox spacing="8" alignment="CENTER_LEFT">
        <Label text="COM-порт:" style="-fx-font-weight: bold;"/>

        <ComboBox fx:id="portCombo"
                  prefWidth="200"
                  promptText="Выберите порт"
                  focusTraversable="false"/>

        <Button fx:id="refreshBtn"
                text="Обновить"
                onAction="#refreshPorts"
                prefWidth="90"
                focusTraversable="false"/>

        <Button fx:id="connectBtn"
                text="Подключиться"
                onAction="#toggleConnection"
                prefWidth="140"
                focusTraversable="false"
                style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <Separator orientation="VERTICAL"/>

        <Label text="Статус:" style="-fx-font-weight: bold;"/>
        <Label fx:id="statusLabel" text="Не подключено" style="-fx-text-fill: #666;"/>
      </HBox>

      <HBox spacing="20" alignment="CENTER_LEFT">
        <Label fx:id="steerLabel" text="Руль: 512" style="-fx-text-fill: #333; -fx-font-family: monospace;"/>
        <Label fx:id="forwardLabel" text="Газ: —" style="-fx-text-fill: #333;"/>
        <Label fx:id="backwardLabel" text="Тормоз/назад: —" style="-fx-text-fill: #333;"/>
        <Separator orientation="VERTICAL"/>
        <Label fx:id="rawLabel" text="Пакет: —" style="-fx-text-fill: #0066cc; -fx-font-family: monospace;"/>
      </HBox>
    </VBox>
  </top>

  <center>
    <StackPane style="-fx-background-color: #1e1e1e;">
      <padding>
        <Insets top="8" right="12" bottom="12" left="12"/>
      </padding>

      <Canvas fx:id="gameCanvas" width="800" height="500" focusTraversable="true"/>
    </StackPane>
  </center>

</BorderPane>